+#[cfg(test)]
+mod local_solid_scene_tests {
+    use super::{CloudMode, ExperimentalShader, RenderMode};
+    use strum::IntoEnumIterator;
+
+    #[test]
+    fn local_solid_scene_rejects_all_requests_and_replacement_preferences() {
+        let mode = RenderMode {
+            cloud: CloudMode::None,
+            ..RenderMode::default()
+        };
+        let (normal, _) = mode.split();
+        let mut pipeline = normal.clone();
+        for shader in ExperimentalShader::iter() {
+            assert!(!shader.is_supported_for_scene(true));
+            pipeline.experimental_shaders.insert(shader);
+        }
+        pipeline.remove_unsupported_for_scene(true);
+        assert_eq!(pipeline, normal);
+        pipeline.experimental_shaders.extend(ExperimentalShader::iter());
+        pipeline.remove_unsupported_for_scene(true);
+        assert_eq!(pipeline, normal);
+    }
+
+    #[test]
+    fn local_solid_scene_preserves_unrequested_native_preferences() {
+        let mut mode = RenderMode::default();
+        for shader in ExperimentalShader::iter() {
+            if shader != ExperimentalShader::Wireframe || cfg!(debug_assertions) {
+                mode.experimental_shaders.insert(shader);
+            }
+        }
+        let (mut pipeline, _) = mode.split();
+        let expected = pipeline.clone();
+        pipeline.remove_unsupported_for_scene(false);
+        assert_eq!(pipeline, expected);
+    }
+}
