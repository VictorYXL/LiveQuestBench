+const ROUTE_LOCAL_VIEW: &str = "native-route-local-view/1";
+
+pub(crate) fn route_observation_contract() -> Option<&'static str> {
+    (std::env::var("LIVEQUEST_ROUTE_OBSERVATION").as_deref() == Ok(ROUTE_LOCAL_VIEW))
+        .then_some(ROUTE_LOCAL_VIEW)
+}
+
+pub(crate) fn route_voxel_map_visible(requested: bool, contract: Option<&str>) -> bool {
+    // A native UI toggle must not restore nonlocal voxel topology in this contract.
+    requested && contract != Some(ROUTE_LOCAL_VIEW)
+}
