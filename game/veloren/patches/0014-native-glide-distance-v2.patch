+    #[test]
+    fn glide_samples_exclude_folded_gaps_and_keep_the_landing() {
+        let mut motion = MotionEvidence::default();
+        motion.sample_glide(false, [0.0, 0.0, 40.0], true);
+        motion.sample_glide(false, [0.0, 1.0, 39.0], true);
+        motion.sample_glide(false, [0.0, 29.0, 20.0], false);
+        motion.sample_glide(false, [0.0, 30.0, 19.0], true);
+        motion.sample_glide(false, [0.0, 31.0, 18.0], true);
+        motion.sample_glide(false, [0.0, 40.0, 2.0], false);
+        motion.sample_glide(true, [0.0, 40.0, 0.0], false);
+        assert_eq!(motion.glide_landings, vec![([0.0, 40.0, 0.0], 2.0)]);
+    }
+
+    #[test]
+    fn glide_samples_sum_segments_without_carrying_into_the_next_flight() {
+        let mut motion = MotionEvidence::default();
+        motion.sample_glide(false, [0.0, 0.0, 40.0], true);
+        motion.sample_glide(false, [0.0, 10.0, 30.0], true);
+        motion.sample_glide(false, [0.0, 30.0, 25.0], false);
+        motion.sample_glide(false, [0.0, 40.0, 20.0], true);
+        motion.sample_glide(false, [0.0, 55.0, 10.0], true);
+        motion.sample_glide(true, [0.0, 60.0, 0.0], false);
+        assert_eq!(motion.glide_landings, vec![([0.0, 60.0, 0.0], 25.0)]);
+        motion.sample_glide(true, [0.0, 70.0, 0.0], true);
+        motion.sample_glide(false, [0.0, 80.0, 4.0], true);
+        motion.sample_glide(false, [0.0, 81.0, 2.0], true);
+        motion.sample_glide(true, [0.0, 82.0, 0.0], false);
+        assert_eq!(motion.glide_landings[1], ([0.0, 82.0, 0.0], 1.0));
+    }
