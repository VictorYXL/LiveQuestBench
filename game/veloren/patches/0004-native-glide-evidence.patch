     #[test]
+    fn glide_samples_require_airborne_glide_and_landing() {
+        let mut motion = MotionEvidence::default();
+        motion.sample_glide(true, [0.0, 0.0, 12.0], false);
+        motion.sample_glide(true, [0.0, 0.0, 12.0], true);
+        motion.sample_glide(false, [0.0, 0.0, 10.0], false);
+        motion.sample_glide(true, [0.0, 0.0, 0.0], false);
+        assert!(motion.glide_landings.is_empty());
+        motion.sample_glide(false, [0.0, 0.0, 12.0], true);
+        motion.sample_glide(false, [0.0, 8.0, 10.0], true);
+        assert!(motion.glide_landings.is_empty());
+        motion.sample_glide(false, [0.0, 20.0, 2.0], false);
+        motion.sample_glide(true, [0.0, 20.0, 0.0], false);
+        assert_eq!(motion.glide_landings, vec![([0.0, 20.0, 0.0], 8.0)]);
+        motion.sample_glide(true, [0.0, 20.0, 0.0], false);
+        assert_eq!(motion.glide_landings.len(), 1);
+        motion.glide_landings.resize(128, ([0.0; 3], 0.0));
+        motion.sample_glide(false, [0.0, 0.0, 12.0], true);
+        motion.sample_glide(true, [0.0, 0.0, 0.0], false);
+        assert!(motion.glide_overflow);
+        assert!(!motion.invalid);
+        motion.sample(7, true, 0.0, 0.0, false);
+        motion.sample(7, false, 1.0, 5.0, false);
+        motion.sample(7, true, 0.0, 0.0, true);
+        assert_eq!(motion.jump_landings, 1);
+        assert_eq!(motion.roll_entries, 1);
+        assert!(!motion.invalid);
+    }
