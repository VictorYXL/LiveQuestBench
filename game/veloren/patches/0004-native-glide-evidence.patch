+    fn sample_glide(&mut self, grounded: bool, point: [f32; 3], gliding: bool) {
+        if point.iter().any(|value| !value.is_finite()) {
+            self.invalid = true;
+            return;
+        }
+        if gliding && !grounded {
+            let (start, distance) = self.glide_flight.get_or_insert((point, 0.0));
+            *distance = distance.max((point[0] - start[0]).hypot(point[1] - start[1]));
+        }
+        if grounded && let Some(flight) = self.glide_flight.take() {
+            if self.glide_landings.len() >= 128 {
+                self.glide_overflow = true;
+            } else {
+                self.glide_landings.push((point, flight.1));
+            }
+        }
+    }
