+// Pure collision core: shared by the renderer and lightweight native regressions.
+fn local_camera_distance(
+    focus: [f32; 3],
+    requested: [f32; 3],
+    radius: f32,
+    mut solid: impl FnMut([i32; 3]) -> bool,
+) -> Option<f32> {
+    if !focus.iter().chain(requested.iter()).all(|v| v.is_finite())
+        || !radius.is_finite()
+        || !(0.0..=1.0).contains(&radius)
+    {
+        return None;
+    }
+    let delta = std::array::from_fn::<_, 3, _>(|i| requested[i] - focus[i]);
+    let length = delta.iter().map(|v| v * v).sum::<f32>().sqrt();
+    if !length.is_finite() {
+        return None;
+    }
+    let distance = length.min(LOCAL_CAMERA_MAX_DISTANCE);
+    let delta = delta.map(|v| if length > 0.0 { v * distance / length } else { 0.0 });
+    let end = std::array::from_fn::<_, 3, _>(|i| focus[i] + delta[i]);
+    let lower = std::array::from_fn::<_, 3, _>(|i| (focus[i].min(end[i]) - radius).floor());
+    let upper = std::array::from_fn::<_, 3, _>(|i| (focus[i].max(end[i]) + radius).floor());
+    if lower.iter().chain(upper.iter()).any(|v| v.abs() > 1_000_000_000.0) {
+        return None;
+    }
+    let lower = lower.map(|v| v as i32);
+    let upper = upper.map(|v| v as i32);
+    let mut limit = 1.0_f32;
+    for x in lower[0]..=upper[0] {
+        for y in lower[1]..=upper[1] {
+            for z in lower[2]..=upper[2] {
+                let cell = [x, y, z];
+                if !solid(cell) {
+                    continue;
+                }
+                let mut enter = 0.0_f32;
+                let mut leave = 1.0_f32;
+                for axis in 0..3 {
+                    let low = cell[axis] as f32 - radius;
+                    let high = cell[axis] as f32 + 1.0 + radius;
+                    if delta[axis].abs() < f32::EPSILON {
+                        if focus[axis] < low || focus[axis] > high {
+                            leave = -1.0;
+                            break;
+                        }
+                    } else {
+                        let a = (low - focus[axis]) / delta[axis];
+                        let b = (high - focus[axis]) / delta[axis];
+                        enter = enter.max(a.min(b));
+                        leave = leave.min(a.max(b));
+                    }
+                }
+                if enter <= leave {
+                    if enter <= 0.0 {
+                        return None;
+                    }
+                    limit = limit.min(enter);
+                }
+            }
+        }
+    }
+    Some(if limit < 1.0 { (distance * limit - 0.01).max(0.0) } else { distance })
+}
+
+fn local_near_plane_radius(fov: f32, aspect: f32) -> Option<f32> {
+    if !fov.is_finite() || !(0.0..std::f32::consts::PI).contains(&fov)
+        || fov == 0.0 || !aspect.is_finite() || aspect <= 0.0
+    {
+        return None;
+    }
+    let half_height = NEAR_PLANE * (fov * 0.5).tan();
+    let radius = (NEAR_PLANE.powi(2) + half_height.powi(2) * (1.0 + aspect.powi(2))).sqrt() + 0.02;
+    (radius.is_finite() && radius <= 1.0).then_some(radius)
+}
