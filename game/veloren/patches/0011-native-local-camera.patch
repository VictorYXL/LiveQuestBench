+fn next_camera_mode(mode: CameraMode, is_admin: bool, has_target: bool, local: bool) -> CameraMode {
+    if !has_target {
+        return if local { CameraMode::ThirdPerson } else { CameraMode::Freefly };
+    }
+    match mode {
+        CameraMode::ThirdPerson => CameraMode::FirstPerson,
+        CameraMode::FirstPerson if is_admin && !local => CameraMode::Freefly,
+        CameraMode::FirstPerson | CameraMode::Freefly => CameraMode::ThirdPerson,
+    }
+}
