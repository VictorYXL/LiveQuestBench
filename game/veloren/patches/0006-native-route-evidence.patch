 impl MotionEvidence {
+    fn sample_route(&mut self, point: [f32; 3]) {
+        if !self.route_enabled {
+            return;
+        }
+        if point.iter().any(|value| !value.is_finite()) {
+            self.invalid = true;
+            return;
+        }
+        let changed = self.route_samples.last().is_none_or(|(_, previous)| {
+            point.iter().zip(previous).map(|(a, b)| (a - b).powi(2)).sum::<f32>() >= 0.01
+        });
+        if changed {
+            if self.route_samples.len() >= 131072 {
+                self.route_overflow = true;
+            } else {
+                self.route_samples.push((self.samples, point));
+            }
+        }
+    }
