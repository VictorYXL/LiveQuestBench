+/// Opt-in, local-only observation of accepted terrain collision increments.
+pub struct NativeRouteTrace {
+    pub entity: specs::Entity,
+    points: std::sync::Mutex<Vec<Vec3<f32>>>,
+    invalid: std::sync::atomic::AtomicU8,
+}
+
+impl NativeRouteTrace {
+    pub fn new(entity: specs::Entity) -> Self {
+        Self {
+            entity,
+            points: std::sync::Mutex::new(Vec::new()),
+            invalid: std::sync::atomic::AtomicU8::new(0),
+        }
+    }
+
+    pub fn reject(&self, reason: u8) {
+        self.invalid.fetch_or(reason, std::sync::atomic::Ordering::Relaxed);
+    }
+
+    pub fn rejection_reasons(&self) -> u8 {
+        self.invalid.load(std::sync::atomic::Ordering::Relaxed)
+    }
+
+    pub fn record(&self, points: &[Vec3<f32>]) {
+        let mut pending = self.points.lock().unwrap();
+        if pending.len() + points.len() > 4096
+            || points.iter().any(|point| !point.x.is_finite() || !point.y.is_finite() || !point.z.is_finite())
+        {
+            if pending.len() + points.len() > 4096 {
+                self.reject(1);
+            }
+            if points.iter().any(|point| !point.x.is_finite() || !point.y.is_finite() || !point.z.is_finite()) {
+                self.reject(2);
+            }
+            return;
+        }
+        pending.extend_from_slice(points);
+    }
+
+    pub fn take(&self) -> (bool, Vec<Vec3<f32>>) {
+        (
+            self.rejection_reasons() != 0,
+            std::mem::take(&mut *self.points.lock().unwrap()),
+        )
+    }
 }
 
