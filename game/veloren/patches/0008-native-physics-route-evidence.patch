+#[test]
+fn route_trace_captures_slow_frame_increments_without_changing_physics() {
+    use common::comp::{NativeRouteTrace, PhysicsState, PreviousPhysCache};
+    use common_ecs::dispatch;
+    let mut state = utils::setup(|builder| {
+        dispatch::<veloren_common_systems::phys::Sys>(builder, &[]);
+    });
+    let player = utils::create_player(&mut state);
+    let initial = Pos(Vec3::new(16., 16., 270.));
+    let velocity = Vel(Vec3::new(0., 24., 0.));
+    let reset = |state: &mut common_state::State| {
+        state.ecs_mut().write_storage::<Pos>().insert(player, initial).unwrap();
+        state.ecs_mut().write_storage::<Vel>().insert(player, velocity).unwrap();
+        state.ecs_mut().write_storage::<PhysicsState>().remove(player);
+        state.ecs_mut().write_storage::<PreviousPhysCache>().remove(player);
+    };
+    reset(&mut state);
+    utils::tick(&mut state, Duration::from_millis(200));
+    let unobserved = utils::get_transform(&state, player).unwrap();
+    assert!(unobserved.0.0.distance(initial.0) > 4.);
+    reset(&mut state);
+    state.ecs_mut().insert(NativeRouteTrace::new(player));
+    utils::tick(&mut state, Duration::from_millis(200));
+    assert_eq!(utils::get_transform(&state, player).unwrap(), unobserved);
+    let trace = state.ecs().read_resource::<NativeRouteTrace>();
+    let (invalid, points) = trace.take();
+    assert!(!invalid);
+    assert_eq!(points.first(), Some(&initial.0));
+    assert_eq!(points.last(), Some(&unobserved.0.0));
+    assert!(points.len() > 10);
+    assert!(points.windows(2).all(|pair| pair[0].distance(pair[1]) < 0.4));
+}
