+//! Versioned fixture-authoring offer. Ordinary quest_request never calls this module.
+use super::*;
+use crate::data::quest::CourierQuestInstance;
+
+#[derive(Clone)]
+pub struct Proposal {
+    pub instance: CourierQuestInstance,
+    pub target_name: String,
+    pub target_site_name: String,
+    pub target_position: Vec2<f32>,
+}
+
+pub fn brain(proposal: Proposal) -> Brain {
+    let messenger = proposal.instance.messenger;
+    let offer = do_dialogue(messenger, move |session| {
+        let proposal = proposal.clone();
+        now(move |ctx, _| {
+            let instance = proposal.instance;
+            let (statement, question) =
+                instance.get_start_dialogue(&proposal.target_name, &proposal.target_site_name);
+            let marker = Marker::at(proposal.target_position)
+                .with_id(instance.target_actor)
+                .with_label(Content::localized("hud-map-character-label")
+                    .with_arg("name", proposal.target_name.clone()))
+                .with_kind(MarkerKind::Character);
+            let expires = ctx.time.add_minutes(180.0);
+            if let Some(accept) = quest::create_deposit(
+                ctx, ItemResource::Coin, instance.get_reward(),
+                session.say_statement(statement).then(session.ask_yes_no_question(question)),
+            ) {
+                accept.and_then(move |yes| {
+                    if yes {
+                        quest::create_quest(
+                            Quest::courier(instance.target_actor, instance)
+                                .with_deposit(ItemResource::Coin, instance.get_reward())
+                                .with_timeout(expires),
+                        )
+                        .then(session.give_marker(marker.clone()))
+                        .then(session.give_marker(marker.clone()))
+                        .then(session.say_statement(Content::localized("npc-response-quest-courier-start")))
+                        .then(session.say_statement(Content::localized("npc-response-quest-courier-start_2")))
+                        .then(session.say_statement(Content::localized("npc-response-quest-courier-start_3")))
+                        .boxed()
+                    } else {
+                        session.say_statement(Content::localized("npc-response-quest-rejected")).boxed()
+                    }
+                }).boxed()
+            } else {
+                session.say_statement(Content::localized("npc-response-quest-nothing")).boxed()
+            }
+        })
+    });
+    Brain {
+        action: Box::new(offer.then(think().repeat()).with_state(DefaultState {
+            socialize_timer: every_range(15.0..30.0),
+            move_home_timer: every_range(400.0..2000.0).chance(0.5),
+        })),
+    }
+}
