+//! Private, one-shot initialization protocol. No player action or quest shortcut.
+use crate::{Server, rtsim::RtSim};
+use common::{
+    comp::{Health, Inventory, Presence},
+    rtsim::{Actor, ItemResource, Profession, Role, RtSimEntity},
+    uid::{IdMaps, Uid},
+};
+use rand::seq::IndexedRandom;
+use rtsim::{data::quest::{CourierQuest, CourierQuestInstance},
+    rule::npc_ai::initial_message::Proposal};
+use serde_json::{Value, json};
+use specs::{Entity, WorldExt};
+use std::{collections::HashMap, num::{NonZeroU32, NonZeroU64},
+    sync::{Mutex, OnceLock}, time::{Duration, Instant}};
+
+#[derive(Clone, Copy, PartialEq, Debug, Default)]
+enum Phase { #[default] Fresh, Prepared, Published, Closed, Failed }
+
+#[derive(Default)]
+struct Gate {
+    phase: Phase,
+    owner: Option<Entity>,
+    ticket: String,
+    started: Option<Instant>,
+    pending: Option<Pending>,
+}
+
+#[derive(Clone)]
+struct Pending {
+    proposal: Proposal,
+    source: Entity,
+    player: Entity,
+    source_uid: Uid,
+    player_uid: Uid,
+}
+
+impl Gate {
+    fn begin(&mut self, owner: Entity) -> Result<(), &'static str> {
+        if self.phase != Phase::Fresh { return Err("native_message_authorization_closed"); }
+        self.phase = Phase::Failed;
+        self.owner = Some(owner);
+        self.started = Some(Instant::now());
+        Ok(())
+    }
+
+    fn authorize(&self, owner: Entity, ticket: &str) -> Result<(), &'static str> {
+        if self.owner != Some(owner) || self.ticket.is_empty() || self.ticket != ticket {
+            return Err("native_message_authorization_denied");
+        }
+        if self.started.is_none_or(|start| start.elapsed() >= Duration::from_secs(120)) {
+            return Err("native_message_preparation_deadline");
+        }
+        Ok(())
+    }
+}
+
+static GATE: OnceLock<Mutex<Gate>> = OnceLock::new();
+
+fn uid(text: Option<&String>) -> Result<Uid, &'static str> {
+    text.and_then(|s| s.parse::<u64>().ok()).and_then(NonZeroU64::new)
+        .map(Uid).ok_or("native_message_invalid_uid")
+}
+
+fn choose(candidates: &[Proposal]) -> Result<Proposal, &'static str> {
+    candidates.choose(&mut rand::rng()).cloned()
+        .ok_or("native_message_unavailable:no_fully_eligible_existing_recipient")
+}
+
+pub(crate) fn request(server: &Server, owner: Entity, args: &[String]) -> Result<Value, &'static str> {
+    if std::env::var("VELOREN_INITIAL_MESSAGE_PROTOCOL").as_deref() != Ok("initial-message-v2") {
+        return Err("native_message_protocol_disabled");
+    }
+    if !crate::private_oracle::enabled() { return Err("native_message_private_evidence_required"); }
+    let result = handle(server, owner, args);
+    if let Err(error) = result {
+        crate::private_oracle::event("initial_message_v2_error", json!({"error": error}));
+    }
+    result
+}
+
+fn handle(server: &Server, owner: Entity, args: &[String]) -> Result<Value, &'static str> {
+    let mut gate = GATE.get_or_init(|| Mutex::new(Gate::default())).lock()
+        .map_err(|_| "native_message_authorization_failed")?;
+    let ecs = server.state.ecs();
+    let maps = ecs.read_resource::<IdMaps>();
+    let identities = ecs.read_storage::<RtSimEntity>();
+    let health = ecs.read_storage::<Health>();
+    let inventories = ecs.read_storage::<Inventory>();
+    let alive = |entity| health.get(entity).is_some_and(|h| !h.is_dead && h.current() > 0.0);
+    let coins = |entity| inventories.get(entity)
+        .map(|inv| inv.item_count(&ItemResource::Coin.to_equivalent_item_def())).unwrap_or(0);
+    let simulation = ecs.read_resource::<RtSim>();
+    match args.first().map(String::as_str) {
+        Some("prepare") => {
+            gate.begin(owner)?;
+            if args.len() != 5 { return Err("native_message_invalid_prepare_arguments"); }
+            let source_uid = uid(args.get(1))?;
+            let player_uid = uid(args.get(2))?;
+            let source = maps.uid_entity(source_uid).filter(|e| alive(*e))
+                .ok_or("native_message_invalid_giver")?;
+            let player = maps.uid_entity(player_uid).filter(|e| alive(*e))
+                .ok_or("native_message_invalid_player")?;
+            let source_id = *identities.get(source).ok_or("native_message_invalid_giver")?;
+            let messenger = ecs.read_storage::<Presence>().get(player)
+                .and_then(|p| p.kind.character_id()).map(Actor::Character)
+                .ok_or("native_message_invalid_player")?;
+            if source == player || player == owner { return Err("native_message_invalid_player"); }
+            let mut excluded = vec![source_id];
+            for value in &args[3..] {
+                let entity = maps.uid_entity(uid(Some(value))?).filter(|e| alive(*e))
+                    .ok_or("native_message_invalid_distractor")?;
+                let id = *identities.get(entity).ok_or("native_message_invalid_distractor")?;
+                if excluded.contains(&id) { return Err("native_message_invalid_distractor"); }
+                excluded.push(id);
+            }
+            let data = simulation.state().data();
+            let giver = data.npcs.get(source_id).filter(|npc| !npc.is_dead()
+                && matches!(npc.role, Role::Civilised(Some(Profession::Farmer))))
+                .ok_or("native_message_invalid_giver")?;
+            if data.quests.related_to(messenger).count() != 0 {
+                return Err("native_message_player_has_contract");
+            }
+            if coins(source) < 150 { return Err("native_message_source_unfunded"); }
+            let mut names = HashMap::new();
+            for (_, npc) in data.npcs.iter().filter(|(_, npc)| matches!(npc.role, Role::Civilised(_))) {
+                if let Some(name) = npc.get_name() { *names.entry(name).or_insert(0usize) += 1; }
+            }
+            let mut candidates = Vec::new();
+            let index = server.index.as_index_ref();
+            for (id, npc) in data.npcs.iter() {
+                if excluded.contains(&id) || npc.is_dead()
+                    || maps.rtsim_entity(id).is_some_and(|e| !alive(e))
+                    || !matches!(npc.profession(), Some(Profession::Hunter | Profession::Farmer
+                        | Profession::Blacksmith | Profession::Alchemist | Profession::Chef
+                        | Profession::Herbalist | Profession::Guard)) { continue; }
+                let Some(name) = npc.get_name().filter(|name| names.get(name) == Some(&1)) else { continue };
+                let distance = giver.wpos.xy().distance(npc.wpos.xy());
+                if !distance.is_finite() || distance > 5000.0 { continue; }
+                for (site_id, site) in data.sites.iter() {
+                    if npc.wpos.xy().distance(site.wpos.as_()) > 512.0 { continue; }
+                    let Some(site_name) = site.world_site.and_then(|id| index.sites.get(id).name()) else { continue };
+                    let instance = CourierQuestInstance {
+                        kind: CourierQuest::Message, spot: None,
+                        source_site: giver.current_site, source_actor: source_id.into(),
+                        target_actor: id.into(), target_site: Some(site_id), messenger,
+                        distance: NonZeroU32::new(distance as u32).unwrap_or(NonZeroU32::new(1).unwrap()),
+                    };
+                    if coins(source) < instance.get_reward().ceil() as u64 { continue; }
+                    candidates.push(Proposal { instance, target_name: name.clone(),
+                        target_site_name: site_name.to_string(), target_position: npc.wpos.xy() });
+                }
+            }
+            let proposal = choose(&candidates)?;
+            let recipient = data.npcs.get(proposal.instance.target_actor.npc().unwrap()).unwrap();
+            gate.ticket = format!("{:032x}", rand::random::<u128>());
+            let result = json!({"protocol": "initial-message-v2", "phase": "prepared",
+                "proposal_id": gate.ticket, "recipient_rtsim_uid": recipient.uid,
+                "recipient_name": proposal.target_name, "instance": proposal.instance,
+                "eligible_proposals": candidates.len(), "accepted_quests_created": 0});
+            gate.pending = Some(Pending { proposal, source, player, source_uid, player_uid });
+            gate.phase = Phase::Prepared;
+            crate::private_oracle::event("initial_message_v2_prepared", result.clone());
+            Ok(result)
+        },
+        Some("publish") => {
+            if args.len() != 2 || gate.phase != Phase::Prepared {
+                return Err("native_message_authorization_closed");
+            }
+            gate.authorize(owner, &args[1])?;
+            gate.phase = Phase::Failed;
+            let pending = gate.pending.as_ref().ok_or("native_message_missing_proposal")?.clone();
+            if maps.uid_entity(pending.source_uid) != Some(pending.source)
+                || maps.uid_entity(pending.player_uid) != Some(pending.player)
+                || !alive(pending.source) || !alive(pending.player) {
+                return Err("native_message_party_changed");
+            }
+            let recipient = maps.actor_entity(pending.proposal.instance.target_actor)
+                .filter(|e| alive(*e)).ok_or("native_message_party_changed")?;
+            let _ = recipient;
+            if coins(pending.source) < pending.proposal.instance.get_reward().ceil() as u64 {
+                return Err("native_message_source_unfunded");
+            }
+            let mut data = simulation.state().data_mut();
+            if data.quests.related_to(pending.proposal.instance.messenger).count() != 0 {
+                return Err("native_message_player_has_contract");
+            }
+            let npc = data.npcs.get_mut(pending.proposal.instance.source_actor.npc().unwrap())
+                .filter(|npc| !npc.is_dead()).ok_or("native_message_party_changed")?;
+            npc.brain = Some(rtsim::rule::npc_ai::initial_message::brain(pending.proposal.clone()));
+            gate.phase = Phase::Published;
+            let result = json!({"protocol": "initial-message-v2", "phase": "published",
+                "proposal_id": gate.ticket, "accepted_quests_created": 0});
+            crate::private_oracle::event("initial_message_v2_published", result.clone());
+            Ok(result)
+        },
+        Some("close") => {
+            if args.len() != 2 || !matches!(gate.phase, Phase::Prepared | Phase::Published | Phase::Failed) {
+                return Err("native_message_authorization_closed");
+            }
+            gate.authorize(owner, &args[1])?;
+            gate.phase = Phase::Closed;
+            gate.pending = None;
+            let result = json!({"protocol": "initial-message-v2", "phase": "closed"});
+            crate::private_oracle::event("initial_message_v2_closed", result.clone());
+            Ok(result)
+        },
+        _ => Err("native_message_invalid_operation"),
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    use specs::Builder;
+
+    #[test]
+    fn authorization_is_one_shot_run_bound_and_expiring() {
+        let mut world = specs::World::new();
+        let owner = world.create_entity().build();
+        let other = world.create_entity().build();
+        let mut gate = Gate::default();
+        assert!(gate.begin(owner).is_ok());
+        assert_eq!(gate.begin(owner), Err("native_message_authorization_closed"));
+        gate.ticket = "run-specific-proposal".into();
+        assert!(gate.authorize(owner, "run-specific-proposal").is_ok());
+        assert!(gate.authorize(other, "run-specific-proposal").is_err());
+        assert!(gate.authorize(owner, "different-run").is_err());
+        gate.started = Some(Instant::now() - Duration::from_secs(121));
+        assert_eq!(gate.authorize(owner, "run-specific-proposal"), Err("native_message_preparation_deadline"));
+    }
+
+    #[test]
+    fn absent_eligibility_and_invalid_identity_fail_explicitly() {
+        assert!(matches!(choose(&[]), Err("native_message_unavailable:no_fully_eligible_existing_recipient")));
+        assert!(uid(Some(&"0".to_string())).is_err());
+        assert!(uid(Some(&"not-an-identity".to_string())).is_err());
+    }
+}
