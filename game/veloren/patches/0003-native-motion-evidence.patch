     #[test]
+    fn motion_samples_require_rise_landing_and_real_roll_phase() {
+        let mut motion = MotionEvidence::default();
+        motion.sample(7, true, 10.0, 0.0, false);
+        motion.sample(7, false, 9.9, -1.0, false);
+        motion.sample(7, true, 9.0, 0.0, false);
+        assert_eq!(motion.jump_landings, 0);
+        motion.sample(7, false, 9.2, 5.0, false);
+        motion.sample(7, false, 9.6, 1.0, false);
+        assert_eq!(motion.jump_landings, 0);
+        motion.sample(7, true, 9.0, 0.0, false);
+        assert_eq!(motion.jump_landings, 1);
+        motion.sample(7, true, 9.0, 0.0, true);
+        motion.sample(7, true, 9.0, 0.0, true);
+        assert_eq!(motion.roll_entries, 1);
+        motion.sample(7, true, 9.0, 0.0, false);
+        motion.sample(7, true, 9.0, 0.0, true);
+        assert_eq!(motion.roll_entries, 2);
+        motion.sample(8, true, 9.0, 0.0, false);
+        assert!(motion.invalid);
