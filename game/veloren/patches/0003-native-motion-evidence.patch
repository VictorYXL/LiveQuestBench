 pub const FRAME_SCHEMA: &str = "1.0";
 mod visual_ui;
 
+#[derive(Default)]
+struct MotionEvidence {
+    uid: Option<u64>,
+    invalid: bool,
+    samples: u64,
+    previous_ground: Option<(bool, f32)>,
+    takeoff: Option<f32>,
+    peak: f32,
+    jump_landings: u64,
+    roll_movement: bool,
+    roll_entries: u64,
+}
+
+impl MotionEvidence {
+    fn sample(&mut self, uid: u64, grounded: bool, z: f32, vz: f32, rolling: bool) {
+        if self.uid.is_some_and(|previous| previous != uid) || !z.is_finite() || !vz.is_finite() {
+            self.invalid = true;
+            return;
+        }
+        self.uid = Some(uid);
+        self.samples += 1;
+        if let Some((true, previous_z)) = self.previous_ground
+            && !grounded && vz > 1.0
+        {
+            self.takeoff = Some(previous_z);
+            self.peak = z;
+        }
+        if let Some(start) = self.takeoff {
+            self.peak = self.peak.max(z);
+            if grounded {
+                if self.peak - start >= 0.5 {
+                    self.jump_landings += 1;
+                }
+                self.takeoff = None;
+            }
+        }
+        if rolling && !self.roll_movement {
+            self.roll_entries += 1;
+        }
+        self.roll_movement = rolling;
+        self.previous_ground = Some((grounded, z));
+    }
+}
