+    #[test]
+    fn atomic_publication_replaces_stale_walk_and_momentum_without_a_hold() {
+        let player = Vec3::new(18703.5, 10809.5, 501.0);
+        let point = Vec3::new(18705.5, 10809.5, 501.0);
+        let mut position = Pos(Vec3::new(18709.5254, 10809.8154, 501.0));
+        assert!(checked_distance(position.0, player).is_err());
+        assert_eq!(checked_distance(point, player), Ok(2.0));
+        let mut velocity = Vel(Vec3::new(4.0, 0.3, 0.0));
+        let mut controls = Controller::default();
+        controls.inputs.move_dir = vek::Vec2::unit_x();
+        let mut activity = RtSimController::with_destination(position.0 + Vec3::unit_x() * 20.0);
+        let messenger = Actor::Character(common::character::CharacterId(16));
+        commit_opening_motion(&mut position, &mut velocity, &mut controls,
+            &mut activity, point, messenger);
+        assert_eq!(position.0, point);
+        assert_eq!(velocity.0, Vec3::zero());
+        assert_eq!(controls.inputs.move_dir, vek::Vec2::zero());
+        assert!(matches!(activity.activity, Some(NpcActivity::Talk(actor)) if actor == messenger));
+        assert!(activity.actions.is_empty());
+    }
+
+    #[test]
+    fn pending_physical_or_inventory_actions_are_rejected_not_discarded() {
+        let mut controls = Controller::default();
+        controls.actions.push(ControlAction::Stand);
+        assert!(controls_quiescent(&controls));
+        controls.actions.push(ControlAction::basic_input(common::comp::InputKind::Jump));
+        assert!(!controls_quiescent(&controls));
+        assert_eq!(controls.actions.len(), 2);
+        controls.actions.clear();
+        controls.events.push(common::comp::ControlEvent::GiveUp);
+        assert!(!controls_quiescent(&controls));
+        assert_eq!(controls.events.len(), 1);
+    }
+
+    #[test]
+    fn native_range_and_finite_coordinates_are_not_relaxed() {
+        let player = Vec3::zero();
+        assert!(checked_distance(Vec3::unit_x() * 4.999, player).is_ok());
+        for x in [5.0, 6.033641, f32::NAN, f32::INFINITY] {
+            assert!(checked_distance(Vec3::new(x, 0.0, 0.0), player).is_err());
+        }
+        assert!(checked_distance(Vec3::zero(), Vec3::new(f32::NAN, 0.0, 0.0)).is_err());
+    }
