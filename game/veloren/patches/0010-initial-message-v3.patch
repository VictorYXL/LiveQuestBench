+fn checked_distance(source: Vec3<f32>, player: Vec3<f32>) -> Result<f32, &'static str> {
+    let distance = source.distance(player);
+    if !source.map(f32::is_finite).reduce_and()
+        || !player.map(f32::is_finite).reduce_and()
+        || !distance.is_finite() || distance >= common::consts::MAX_INTERACT_RANGE {
+        return Err("native_message_source_out_of_range");
+    }
+    Ok(distance)
+}
+
+fn commit_opening_motion(
+    position: &mut Pos, velocity: &mut Vel, controls: &mut Controller,
+    activity: &mut RtSimController, point: Vec3<f32>, messenger: Actor,
+) {
+    position.0 = point;
+    velocity.0 = Vec3::zero();
+    controls.reset();
+    activity.activity = Some(NpcActivity::Talk(messenger));
+}
+
+fn controls_quiescent(controls: &Controller) -> bool {
+    controls.events.is_empty() && controls.actions.iter().all(|action| matches!(action,
+        ControlAction::Stand | ControlAction::Talk(_) | ControlAction::Wield | ControlAction::Unwield))
+}
