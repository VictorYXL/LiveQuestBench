# Python environments, caches and build artifacts
.venv/
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
.coverage.*
htmlcov/
build/
dist/
*.egg-info/
node_modules/

# Local credentials and editor settings
.env
.env.*
!.env.example
.envrc
.pypirc
.vscode/
.idea/
accounts.json
accounts.json.*

# Temporary scripts, exploratory tests, logs and recordings
# Local research, development evidence and archived checks stay untracked.
/output/
*.log
*.mp4

# Game downloads and runtime data (normally outside the repository)
/runtime/
/downloads/
/world/
/world.*/
*.AppImage
*.jar

# Track pyproject.toml, .python-version and uv.lock.
# Do not ignore game patches, maintained tests or .github/ workflows.
